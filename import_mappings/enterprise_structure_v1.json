{
  "mapping_name": "enterprise_bom_structure_v1",
  "publication_scope": "structure",
  "price_policy": "optional",
  "unit_policy": "optional_for_structure",
  "publish_parent_item": true,
  "metadata": {
    "parent_material_code": {"aliases": ["项目代号", "产品编码", "父项编码"]},
    "version": {"aliases": ["版本号", "BOM版本"]}
  },
  "columns": {
    "material_code": {"aliases": ["料号", "物料代码"]},
    "material_name": {"aliases": ["名称", "物料名称"]},
    "specification": {"aliases": ["规格型号"]},
    "quantity": {"aliases": ["数量", "单位用量"]},
    "tax_included_unit_price": {"aliases": ["含税单价"]},
    "total_price": {"aliases": ["总价"]},
    "unit": {"aliases": ["单位", "计量单位"]},
    "currency": {"aliases": ["币种"]},
    "effective_from": {"aliases": ["生效日期"]}
  },
  "required_columns": ["material_code", "quantity"],
  "pending_when_absent": ["unit", "currency", "effective_from"],
  "stop_row_markers": ["合计", "总计"],
  "header_scan_limit": 100,
  "validation": {"total_price_tolerance": "0.01"}
}
