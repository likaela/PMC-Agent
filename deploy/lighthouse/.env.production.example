# 生产环境变量模板
# 用法：cp deploy/lighthouse/.env.production.example .env 然后填写真实值
# 注意：.env 已被 .gitignore 排除，不会提交到 git，也不会随 clone 传播

# 数据源：demo 使用内置演示数据（SQLite），无需外部数据库
PMC_DATA_SOURCE=demo

# LLM 供应商：deepseek 或 mimo
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=在这里填你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：MiMo 供应商（二选一，无需同时配置）
# LLM_PROVIDER=mimo
# MIMO_API_KEY=
# MIMO_BASE_URL=

# LLM 超时与重试
LLM_TIMEOUT_SECONDS=6
LLM_MAX_RETRIES=1

# 前端同源反代后，无需额外 CORS 配置；保留本地开发默认即可
PMC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
