{
	admin off
	persist_config off
	auto_https off
}
http://:8090 {
	bind 127.0.0.1
	basic_auth {
		{$PMC_REVIEW_USER_A} {$PMC_REVIEW_HASH_A}
		{$PMC_REVIEW_USER_B} {$PMC_REVIEW_HASH_B}
		{$PMC_REVIEW_USER_C} {$PMC_REVIEW_HASH_C}
	}
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	request_body {
		max_size 64KB
	}
	@private path /data/* /.env* /.git/* /.runtime/* /deploy/* /docs/* /src/* /node_modules/*
	handle @private {
		respond "该路径不可访问。" 404
	}
	@backend path /api/* /health
	handle @backend {
		reverse_proxy 127.0.0.1:8020 {
			header_up X-PMC-Proxy-Key {$PMC_REVIEW_PROXY_SECRET}
			header_up X-PMC-User {http.auth.user.id}
			header_up -Authorization
		}
	}
	handle {
		root * "{$PMC_REVIEW_WEB_ROOT}"
		try_files {path} /index.html
		file_server
	}
}
